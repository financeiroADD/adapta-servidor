# Copie estes nomes para o painel de variáveis da hospedagem (Railway/Render/etc.).
# NUNCA coloque os valores reais em arquivo dentro do GitHub.

# --- WhatsApp (painel developers.facebook.com > seu app > WhatsApp) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=invente-uma-senha-longa-aqui
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- PedidoOK ---
PEDIDOOK_TOKEN_PARCEIRO=
PEDIDOOK_TOKEN=

# --- IA (platform.claude.com > chave da API) ---
ANTHROPIC_API_KEY=

# --- Quem pode falar com o agente (papéis: dono, compras, financeiro, vendas) ---
# Telefone com 55 + DDD + número.
USUARIOS=[{"nome":"Danilo","telefone":"5592900000000","papel":"dono"}]

# --- Segurança ---
# NODE_ENV=production já vem no Dockerfile. Em produção o servidor só aceita endereços HTTPS
# e nunca aceita webhook sem assinatura. WHATSAPP_VERIFY_TOKEN: 16 caracteres ou mais.
# SAUDE_TOKEN=              (opcional: /saude?token=... mostra detalhes; sem ele, /saude só diz se está no ar)

# --- Opcionais ---
# DATA_DIR=/dados            (pasta com disco permanente)
# SYNC_HORAS=2               (de quanto em quanto tempo baixa os dados do PedidoOK)
# LIMITE_MSG_HORA=40         (mensagens por pessoa por hora, protege o saldo da IA)
# LIMITE_MSG_DIA=300         (mensagens por pessoa por dia)
# TETO_IA_MES=200            (teto de gasto da IA no WhatsApp por mês, em reais; perto dele a equipe fica sem análise completa e, acima, no modo rápido)
# COTACAO_DOLAR=5.5          (cotação usada para converter o gasto da IA para reais)
# GRAPH_VERSION=v23.0        (versão da API da Meta; confira a atual no painel)

# --- Gravar no PedidoOK pelo WhatsApp (mesmas regras do programa; sempre com "confirmar") ---
# ACOES_PEDIDOOK=1           (0 desliga: o agente volta a só consultar)

# --- Aviso de segurança ao Dono fora da janela de 24 horas ---
# Se o Dono não escreveu para o agente nas últimas 24 horas, a Meta só aceita um modelo (template) aprovado.
# Crie o modelo no painel da Meta (WhatsApp > Modelos de mensagem), categoria Utilidade, idioma Português (BR);
# o texto exato está no LEIA-ME.md. Se usar outro nome, informe aqui.
# WHATSAPP_MODELO_AVISO=adaptus_aviso_seguranca
# WHATSAPP_MODELO_IDIOMA=pt_BR
